# Copy this file to ".env" and fill in what you need. Everything is OPTIONAL:
# without any of it IPECS runs fully offline (manual entry + PaddleOCR).

# Gemini AI (online receipt extraction + spending insights) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8

# Supabase (sync) - Project Settings > API. Run supabase_schema.sql in the SQL editor first.
SUPABASE_URL=
SUPABASE_KEY=

# Password of the hard-coded administrator (username: admin). Change it!
ADMIN_PASSWORD=admin123
